#!/bin/sh
#
# Runs before every commit: the repository guard, then the fast test tiers (unit and
# integration, component, harness and deterministic complexity).
#
# The guard (plugin/scripts/repo-guard.mjs) refuses stray tool output, build results, big files,
# credentials and real home paths in what is staged. It needs nothing but node and takes well
# under a second, so it runs even when plugin/node_modules is missing. See
# docs/Repository guard.md for how to allow something on purpose.
#
# Complexity checks already run in `npm test`; `test:perf` is only a filter of that config.
# The end-to-end tier (`npm run test:e2e`) is not run here: it needs a running Obsidian app,
# which cannot be assumed at commit time.
#
# Enabled by `npm run prepare` in plugin/, which points core.hooksPath at this directory.
# Skip a run with `git commit --no-verify` when committing work in progress.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root/plugin"

node scripts/repo-guard.mjs --staged

# Private examples and identity checks stay outside the public repository.
privacy_gate="$HOME/.config/abele/anonymous-check.mjs"
if [ -f "$privacy_gate" ]; then
  # From the repository's root, which is where it reads the manifest from.
  (cd "$repo_root" && node "$privacy_gate" --staged)
else
  echo "pre-commit: local privacy gate is not installed; agent must review the staged diff manually"
fi

if [ ! -d node_modules ]; then
  echo "pre-commit: plugin/node_modules missing, skipping tests"
  exit 0
fi

echo "pre-commit: running the tests related to the staged files…"
# Guards above must see the committing index. Tests below must not inherit the hook's
# repository context: a fixture's cwd is otherwise overridden by GIT_DIR/INDEX_FILE.
# Strip every GIT_* key, including configuration overrides and future Git variables.
(
  for name in $(env | awk -F= '/^GIT_[^=]*=/{print $1}'); do
    unset "$name"
  done
  # Only the tests related to what is staged: agents commit in small steps, several at once, and a
  # full run on every commit took most of the machine. The landing check, the release and CI run
  # the whole suite. A change to the test harness, configuration or dependencies runs everything.
  staged=$(git -C "$repo_root" diff --cached --name-only --diff-filter=ACMR -- plugin | sed 's#^plugin/##')
  if [ -z "$staged" ]; then exit 0; fi
  if echo "$staged" | grep -qE '^(package(-lock)?\.json|vitest[^/]*|tsconfig[^/]*|vite\.config[^/]*|tests/(helpers|mocks|setup)[^ ]*)'; then
    npm test --silent
  else
    # shellcheck disable=SC2086
    npx vitest related --run --passWithNoTests --silent $staged
  fi
)
