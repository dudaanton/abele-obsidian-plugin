+import { z } from 'zod'
+
+const responses = new WeakMap<z.ZodType, z.ZodType>()
+
+/**
+ * A receiving boundary: ignore additional object fields, recursively, while retaining
+ * known-field validation, limits and refinements. Never use this for outgoing requests.
+ * Cloning keeps shared protocol schemas (including request/response shapes) strict.
+ */
+export function responseSchema<T extends z.ZodType>(schema: T): T {
+  const cached = responses.get(schema)
+  if (cached) return cached as T
+  const copy = (value: unknown): unknown => {
+    if (value instanceof z.ZodType) return responseSchema(value)
+    if (Array.isArray(value)) return value.map(copy)
+    if (value && typeof value === 'object' && Object.getPrototypeOf(value) === Object.prototype) {
+      const properties = Object.getOwnPropertyDescriptors(value)
+      for (const [key, property] of Object.entries(properties)) {
+        if ('value' in property) property.value = copy(property.value)
+        else if (property.get && key !== 'defaultValue') {
+          const get = property.get
+          property.get = () => copy(get.call(value))
+        }
+      }
+      // Zod's defaultValue getter calls its factory at parse time and creates fresh
+      // objects. Preserve it verbatim instead of invoking it while cloning a schema.
+      return Object.defineProperties({}, properties)
+    }
+    return value
+  }
+  const def = copy(schema.def) as typeof schema.def
+  // Lazy children are evaluated only after their parent has entered the cache.
+  if (schema instanceof z.ZodLazy) {
+    const getter = schema.def.getter
+    Object.assign(def, { getter: () => responseSchema(getter() as z.ZodType) })
+  }
+  if (schema instanceof z.ZodObject && schema.def.catchall instanceof z.ZodNever)
+    // Merged object definitions expose catchall as a getter without a setter.
+    // Replace the descriptor on the clone; never assign through the original accessor.
+    Object.defineProperty(def, 'catchall', {
+      value: undefined,
+      writable: true,
+      enumerable: true,
+      configurable: true,
+    })
+  const result = z.core.clone(schema, def)
+  responses.set(schema, result)
+  return result
+}
