{
  "name": "abele-obsidian-plugin",
  "version": "1.63.1",
  "description": "This is Abele Obsidian plugin.",
  "main": "main.js",
  "scripts": {
    "dev": "vite preview",
    "build": "tsc -noEmit -skipLibCheck && vite build",
    "build:test": "tsc -noEmit -skipLibCheck && vite build --mode development",
    "types": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run .perf.test.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:phone": "E2E_TARGET=phone vitest run --config vitest.e2e.config.ts",
    "test:size": "vitest run --config vitest.size.config.ts",
    "guard": "node scripts/repo-guard.mjs --all",
    "guard:staged": "node scripts/repo-guard.mjs --staged",
    "measure:tokens": "vitest run --config vitest.measure.config.ts",
    "test:all": "npm run test && npm run test:size && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "cd .. && ./plugin/node_modules/.bin/eslint --no-config-lookup --config plugin/eslint.config.mjs .",
    "lint:fix": "cd .. && ./plugin/node_modules/.bin/eslint --no-config-lookup --config plugin/eslint.config.mjs . --fix",
    "version": "node version-bump.mjs && git add ../manifest.json ../versions.json",
    "lint:review": "cd .. && ./plugin/node_modules/.bin/eslint --no-config-lookup --config plugin/eslint.review.mjs plugin/src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "https://github.com/lishid/cm-language",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "obsidian": "latest",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.11.0",
    "@vueuse/core": "^13.4.0",
    "dayjs": "^1.11.18",
    "dom-to-image-more": "^3.7.2",
    "echarts": "^6.0.0",
    "fflate": "^0.8.2",
    "fparser": "^4.2.0",
    "front-matter": "^4.0.2",
    "ical.js": "2.2.1",
    "js-yaml": "^4.3.1",
    "jsqr": "^1.4.0",
    "maplibre-gl": "6.10.0",
    "nanoid": "^5.1.6",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.16"
  }
}
